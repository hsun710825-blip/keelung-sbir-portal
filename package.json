{
  "name": "keelung-sbir-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:a11y": "eslint --config eslint.a11y.config.mjs \"app/**/*.{js,jsx,ts,tsx}\" \"components/**/*.{js,jsx,ts,tsx}\"",
    "deploy": "npx vercel deploy --prod --yes",
    "phase1:backup": "npx tsx scripts/phase1-data-cleanup.ts backup",
    "phase1:verify": "npx tsx scripts/phase1-data-cleanup.ts verify",
    "phase1:delete": "npx tsx scripts/phase1-data-cleanup.ts delete --confirm",
    "eval:clear": "npx tsx scripts/clear-evaluations.ts",
    "review:assign-meetings": "npx tsx --env-file=.env --env-file=.env.local scripts/assign-review-meetings.ts",
    "settlement:import": "npx tsx --env-file=.env --env-file=.env.local scripts/import-settlement-reference.ts",
    "settlement:fix-junyan": "npx tsx --env-file=.env --env-file=.env.local scripts/fix-junyan-typo.ts",
    "app:delete-unnamed": "npx tsx --env-file=.env --env-file=.env.local scripts/delete-unnamed-test-app.ts",
    "revision:copy-submitted": "npx tsx --env-file=.env --env-file=.env.local scripts/copy-submitted-pdfs-to-revision-folder.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@napi-rs/canvas": "^1.0.2",
    "@next/third-parties": "^16.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.0",
    "@react-pdf/renderer": "^4.3.2",
    "dagre": "^0.8.5",
    "docx": "^9.7.1",
    "firebase": "^12.11.0",
    "googleapis": "^171.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reactflow": "^11.11.4",
    "sharp": "^0.35.2",
    "tesseract.js": "^7.0.0",
    "typeface-noto-sans-tc": "^1.1.13",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
